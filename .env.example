# ── Databases ─────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading
QUESTDB_URL=postgresql://trading:trading@localhost:8812/qdb
REDIS_URL=redis://localhost:6379/0

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=trading

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt(12)).decode())"
AUTH_PROVIDER=local
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=\$2b\$12\$REPLACE_WITH_BCRYPT_HASH
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_run_python3_-c_secrets.token_hex_32
JWT_EXPIRY_HOURS=24

# ── LLM (optional — set ENABLE_LLM_CHAT=false to disable) ────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ENABLE_LLM_CHAT=false

# ── Storage ───────────────────────────────────────────────────────────────────
PARQUET_BASE_PATH=/tmp/trading_parquet

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_LIVE_SIGNALS=true
SAFETY_GATE_AGENT_CODE=true
