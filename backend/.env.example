# backend/.env.example
POSTGRES_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading
QUESTDB_URL=postgresql://admin:quest@localhost:8812/qdb
REDIS_URL=redis://localhost:6379
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=trading
JWT_SECRET=change-me-to-a-256-bit-random-key-in-production
JWT_EXPIRY_HOURS=24
AUTH_PROVIDER=local
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
PARQUET_BASE_PATH=/data/raw
SCHEMA_VERSION=v1
SCANNER_DSL_VERSION=1
ENABLE_LIVE_SIGNALS=true
ENABLE_LLM_CHAT=true
SAFETY_GATE_AGENT_CODE=true
SHOONYA_MAX_CONCURRENT=10
