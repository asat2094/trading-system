{
  "title": "Ingestion Health",
  "uid": "ingestion-health",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Rows Written (last 1h)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(ingestion_rows_written_total[1h]))",
          "legendFormat": "rows"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ingestion Failures (last 1h)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(ingestion_failures_total[1h]))",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ingestion Rows by Source",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(ingestion_rows_written_total[5m])",
          "legendFormat": "{{source}} {{timeframe}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ingestion Duration (p95)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(ingestion_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{workflow}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Data Gaps Detected (last 24h)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(data_gap_detected_total[24h]))",
          "legendFormat": "gaps"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Signals Fired by Type",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(signals_fired_total[5m])",
          "legendFormat": "{{signal_name}} {{direction}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Redis Cache Hit Rate",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(redis_cache_hits_total[5m]) / (rate(redis_cache_hits_total[5m]) + rate(redis_cache_misses_total[5m]))",
          "legendFormat": "hit rate"
        }
      ]
    }
  ]
}
