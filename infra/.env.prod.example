# Copy to infra/.env.prod and fill in values before deploying

# Database credentials
POSTGRES_USER=trading
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Connection URLs (use service names — docker compose internal DNS)
POSTGRES_URL=postgresql+asyncpg://trading:CHANGE_ME_STRONG_PASSWORD@postgres:5432/trading
QUESTDB_URL=postgresql://admin:quest@questdb:8812/qdb
REDIS_URL=redis://redis:6379

# Temporal
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=trading

# Auth
JWT_SECRET=CHANGE_ME_256_BIT_RANDOM_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=  # generate with: python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('yourpassword'))"

# LLM
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6

# Feature flags
ENABLE_LIVE_SIGNALS=true
ENABLE_LLM_CHAT=true
SAFETY_GATE_AGENT_CODE=true
